<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Keepr is offline-first and private: no INTERNET permission is requested.
        Permissions are added only alongside the feature that needs them.
    -->

    <!-- Reminders (notifications/): see android/docs/NOTIFICATIONS.md. -->
    <!-- Android 13+: asked only when the user turns reminders on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms pending reminders after a reboot; alarms don't survive one. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Exact timing when the user allows it (granted automatically on 12 and
        13, user-controlled from 14). Never requested; without it reminders
        are inexact. USE_EXACT_ALARM is deliberately not used: Play reserves
        it for alarm-clock and calendar apps.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- End reminders. -->
    <!-- Files (engineer B): lets "Take Photo" find the system camera app on Android 11+.
         The camera is used through its intent, so no CAMERA permission is requested. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
        Contacts (import and Catch Up): read-only. Keepr never writes to the
        address book. Asked for only when the person taps "Allow Contacts".
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keepr">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reminders: posts a notification when its alarm goes off. -->
        <receiver
            android:name=".notifications.ReminderReceiver"
            android:exported="false" />
        <!-- Reminders: sets every pending alarm again when the system forgets them. -->
        <receiver
            android:name=".notifications.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- End reminders. -->
        <!-- ===== Files (engineer B) ===== -->
        <!-- Lends the camera app a private file to write a new photo into, and lends a
             shared or opened file to the app the person picked: read-only, one URI at a time. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/keepr_file_paths" />
        </provider>
        <!-- Asks Google Play services for the backported photo picker on Android 8-10,
             so "Choose Photos" never needs a storage permission. -->
        <service
            xmlns:tools="http://schemas.android.com/tools"
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES" />
            </intent-filter>
            <meta-data
                android:name="photopicker_activity:0:required"
                android:value="" />
        </service>
        <!-- ===== end Files ===== -->
    </application>

</manifest>
