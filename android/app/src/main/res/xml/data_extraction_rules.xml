<?xml version="1.0" encoding="utf-8"?>
<!--
    Relationship data never leaves the device through Android's cloud backup or
    device-to-device transfer. Matches the iOS app's privacy stance; revisit only
    when sync is deliberately designed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
